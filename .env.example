# AI Email Management Agent - Sozlamalar

# Server
DEBUG=True
HOST=0.0.0.0
PORT=8000
SECRET_KEY=super-secret-key-change-in-production-12345

# Database
DATABASE_URL=sqlite+aiosqlite:///./email_agent.db

# Telegram Bot
# BotFather'dan olingan token (masalan: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=YourEmailAgentBot

# AI LLM Provayderlari (Ixtiyoriy - birortasini kiriting yoki bo'sh qoldiring, lokal AI ishlayveradi)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Foydalanuvchi afzalliklari (Default User Memory)
DEFAULT_REPLY_TONE=Professional
DEFAULT_LANGUAGE=Uzbek
MAX_SUMMARY_BULLETS=4
